# HostelAdda Full-Stack Environment Configuration

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/hosteladda?schema=public
# Neon Serverless: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/hosteladda?sslmode=require
# Supabase: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hosteladda?schema=public"

# Authentication Secret for signing JWT session cookies (Generate with: openssl rand -base64 32)
AUTH_SECRET="hosteladda-super-secure-campus-food-secret-key-2026"

# Platform URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Image Storage Key (Abstraction supports local `/public/uploads` & Cloudinary/S3 keys)
IMAGE_STORAGE_KEY="hosteladda-demo-storage-key"
